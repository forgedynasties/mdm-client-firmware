<?xml version="1.0" encoding="utf-8"?>
<!-- AIO Home, Linen (C): a big light clock, the date and where the tablet is, and a white card
     that opens the menu app. Ink on the linen wallpaper. Rows 1-3 of the T7's 4x5 grid (120dp
     to 408dp from the top), placed to match the demo: the clock's digits 11.5dp under the top
     (Poppins ExtraLight 92sp, whose line box starts 32dp above the digits), the date's baseline
     at 103dp and the card from 156dp to 230dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">
    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="-20.7dp"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:fontFamily="aio-sans-thin"
        android:includeFontPadding="false"
        android:letterSpacing="-0.06"
        android:textColor="#FF111113"
        android:textSize="92sp" />
    <TextView
        android:id="@+id/home_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="-20dp"
        android:ellipsize="end"
        android:fontFamily="aio-sans"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF6B6B70"
        android:textSize="14sp" />
    <LinearLayout
        android:id="@+id/home_card"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="48.3dp"
        android:background="@drawable/home_card_linen"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/guest_icon_gradient"
            android:padding="12dp"
            android:src="@drawable/ic_home_menu" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/home_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans-medium"
                android:maxLines="1"
                android:textColor="#FF111113"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/home_card_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans"
                android:maxLines="1"
                android:textColor="#FF6B6B70"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/home_card_go"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/home_oval_ink"
            android:padding="9.5dp"
            android:src="@drawable/ic_home_arrow" />
    </LinearLayout>
</LinearLayout>
