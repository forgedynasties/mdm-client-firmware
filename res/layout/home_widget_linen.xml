<?xml version="1.0" encoding="utf-8"?>
<!-- AIO Home, Linen (C): a big light clock, the date and where the tablet is, and a white card
     that opens the menu app. Ink on the linen wallpaper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp">
    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:fontFamily="aio-sans-light"
        android:includeFontPadding="false"
        android:letterSpacing="-0.05"
        android:textColor="#FF111113"
        android:textSize="84sp" />
    <TextView
        android:id="@+id/home_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="aio-sans"
        android:maxLines="2"
        android:textColor="#FF6B6B70"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:id="@+id/home_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/home_card_linen"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">
        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/guest_icon_gradient"
            android:padding="12dp"
            android:src="@drawable/ic_home_menu" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/home_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans-medium"
                android:maxLines="1"
                android:textColor="#FF111113"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/home_card_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans"
                android:maxLines="1"
                android:textColor="#FF6B6B70"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/home_card_go"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/home_oval_ink"
            android:padding="9dp"
            android:src="@drawable/ic_home_arrow" />
    </LinearLayout>
</LinearLayout>
