<?xml version="1.0" encoding="utf-8"?>
<!-- AIO Home, Setup (D), before the tablet is assigned: five steps to "ready for guests", each
     ticking itself, under a progress ring and the headline, as in the demo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp">
            <ProgressBar
                android:id="@+id/home_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="5"
                android:progressDrawable="@drawable/home_ring" />
            <TextView
                android:id="@+id/home_ring_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="aio-sans"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </FrameLayout>
        <TextView
            android:id="@+id/home_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="aio-sans-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="25sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/home_s1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/home_step"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/home_s1_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/home_dot_todo"
            android:fontFamily="aio-sans-medium"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/home_s1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="aio-sans-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/home_s1_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans"
                android:maxLines="1"
                android:textColor="#FFB9B5AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/home_s2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/home_step"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/home_s2_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/home_dot_todo"
            android:fontFamily="aio-sans-medium"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/home_s2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="aio-sans-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/home_s2_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans"
                android:maxLines="1"
                android:textColor="#FFB9B5AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/home_s3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/home_step"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/home_s3_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/home_dot_todo"
            android:fontFamily="aio-sans-medium"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/home_s3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="aio-sans-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/home_s3_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans"
                android:maxLines="1"
                android:textColor="#FFB9B5AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/home_s4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/home_step"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/home_s4_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/home_dot_todo"
            android:fontFamily="aio-sans-medium"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/home_s4_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="aio-sans-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/home_s4_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans"
                android:maxLines="1"
                android:textColor="#FFB9B5AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/home_s5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/home_step"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/home_s5_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/home_dot_todo"
            android:fontFamily="aio-sans-medium"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/home_s5_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="aio-sans-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/home_s5_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="aio-sans"
                android:maxLines="1"
                android:textColor="#FFB9B5AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
