<?xml version="1.0" encoding="utf-8"?>
<!-- AIO Home, Setup: the progress ring from the demo, 58dp across with a 6dp band, coral over a
     faint track, starting at the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.52" android:thicknessRatio="9.7"
            android:useLevel="false">
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270"
            android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.52" android:thicknessRatio="9.7"
                android:useLevel="true">
                <solid android:color="#FFF9674E" />
            </shape>
        </rotate>
    </item>
</layer-list>
